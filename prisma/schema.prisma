// shop-engine 数据模型（阶段 1 骨架）
// 设计依据：plans/01-engine.md D 节（极简通用模型）+ DIRECTION.md 优先级 1
// 约定：垂直差异一律进 jsonb（config），加类目 = 加配置，不重写表

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 垂直赛道：开店时选一个（一家店一个赛道）
enum Vertical {
  FOOD // 咖啡/餐饮（阶段 1 客户菜单页）
  MOTO // 摩托维修（引擎原型）
  SALON // 美容/美甲/美睫
  PET // 宠物店
  LAUNDRY // 洗衣/洗鞋
}

// 订单状态流：各垂直可在 config 里扩展，此处为基础公共状态
enum OrderStatus {
  PENDING // 已下单 / 待处理
  IN_PROGRESS // 服务中 / 制作中
  READY // 待取 / 待接走
  COMPLETED // 已结单 / 已取
  CANCELLED // 已取消
}

enum ReminderStatus {
  PENDING // 待触发（到点冒泡）
  SENT // 已发送
  DISMISSED // 已忽略
}

// 用户角色：阶段 1 只区分店主（OWNER）与运营（ADMIN），不细化权限
enum UserRole {
  OWNER // 店主（绑定一家店）
  ADMIN // 平台运营（后续门户层用，阶段 1 预留）
}

// 店铺 = 租户（一次部署 + shopId 隔离）
model Shop {
  id        String   @id @default(cuid())
  slug      String   @unique // 对外访问的短标识，如 demo-pho
  name      String
  vertical  Vertical
  phone     String? // Zalo 号码
  address   String?
  open      Boolean  @default(true) // 营业开关（老板侧一页后台可切换）
  config    Json? // 垂直配置：营业时间 / 起送价 / 提醒模板 / 预设大按钮等
  plan              String    @default("TRIAL") // 套餐档位：TRIAL / BASIC / PRO（可扩展）
  subscribedUntil   DateTime? // 当前订阅到期；null=无期限；过期 = subscribedUntil < now
  platformSuspended Boolean   @default(false) // 平台人工停用（违规/冻结），独立于老板 open 打烊
  featured          Boolean   @default(false) // 平台推荐位（推广曝光，聚合首页排序用）
  approved          Boolean   @default(true) // 入驻审核：false=待审/被拒（审核开关开启时新建店默认 false，通过后置 true）
  rejectReason      String? // 入驻审核驳回原因（被拒前台显示；审核开关关闭时不使用）
  currency          String    @default("VND") // ISO 4217 货币码，一店一币种（多币种基础）
  city              String    @default("hcm") // 所属城市短码（CITY_SLUG）；阶段3 后接 City 表外键
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  orders    Order[]
  reminders Reminder[]
  users     User[]
  billings  Billing[]
  shopDrafts ShopDraft[]
  vehicles  Vehicle[]

  @@index([city, vertical]) // 城市×垂直聚合列表查询键（listVerifiedShops where vertical+city）
}

// 商品 / 服务项（快捷开单大按钮即预置 product）
model Product {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String // 主文案（一般取越南语），多语可放 config.nameI18n
  price     Decimal @db.Decimal(12, 2)
  unit      String? // 份 / 次 / 公斤 / 件
  category  String? // 分类（用于菜单分组）
  sortOrder Int     @default(0)
  active    Boolean @default(true) // 下架 = false
  config    Json? // 垂直专属：周期(21天) / 时长 / 图片URL等
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, active])
}

// 订单（统一模型，items/状态/垂直字段都在这里）
model Order {
  id        String      @id @default(cuid())
  orderNo   Int // 店内自增（唯一约束兜底）
  displayNo String // 对外订单号 CP-YYMMDD-NNN（人工可读，客户查单用）
  shopId    String
  shop      Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(PENDING)
  items     Json // [{productId?, name, qty, price}] 开单时快照，防改价后追溯失真
  total     Decimal     @db.Decimal(12, 2)
  paidAmount Decimal    @default(0) @db.Decimal(12, 2) // 实收：0=未付，0<实收<total=部分付，≥total=已付；欠款=total-paidAmount
  customerName  String?
  customerPhone String?
  customerId    String? // 身份融合（2026-08-31）：登录客户下单写入；游客匿名单为 null
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  note      String?
  idempotencyKey String? // 下单幂等键（客户端 uuid，防双击/重放重复建单）
  config    Json? // 垂直专属：预约时间 / 寄养天数 / 公斤数 / 标签码 / 次卡扣减等
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  reminders Reminder[]

  @@unique([shopId, orderNo])
  @@unique([shopId, displayNo])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  // P4-AF：大店订单列表过滤（findOrdersForDashboard 的 where shopId+status in[...] + orderBy createdAt desc）
  @@index([shopId, status, createdAt])
  @@index([customerId]) // 「我的订单」按账号列出的查询键
}

// 半自动到点提醒（到点冒泡，老板一键复制发 Zalo，0 API）
model Reminder {
  id          String         @id @default(cuid())
  shopId      String
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  templateKey String // 如 FOOD_READY / SALON_BOOKING_2H / PET_DONE / LAUNDRY_READY
  dueAt       DateTime
  status      ReminderStatus @default(PENDING)
  sentVia     String? // 预留：zalomsg / whatsapp / line
  payload     Json? // 模板变量（客户名/宠物名/订单号等）
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([shopId, dueAt, status])
}

// 登录账号（阶段 1：一店主一店，手机号+密码）
model User {
  id           String   @id @default(cuid())
  shopId       String?
  shop         Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  phone        String   @unique
  username     String?  @unique // 平台运营 ADMIN 登录用户名（第 20 批后加：后台不用手机号当管理员名；owner 保持 null）
  passwordHash String
  name         String?
  role         UserRole @default(OWNER)
  totpSecret   String? // AES-256-GCM 加密的 TOTP 密钥（lib/totp.ts，admin 二次验证用）
  totpEnabled  Boolean  @default(false) // 是否已绑定 TOTP（admin 首次绑定引导后置 true）
  failedAttempts Int      @default(0) // 登录失败累计（超阈值触发锁定）
  lockedUntil    DateTime? // 登录锁定截止；锁定期间拒绝登录（后台解锁清除）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId])
}

// 收费流水（「收费」的地基：谁 / 何时 / 续到何时 / 多少钱，避免收费无处记账）
model Billing {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan      String // 套餐档位：TRIAL / BASIC / PRO
  amount    Decimal  @db.Decimal(12, 2) // 实收金额
  months    Int? // 续费月数
  note      String? // 备注
  createdBy String? // 操作 ADMIN 手机号/名
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

// 预生成菜品模板（第 19 批 A1）：一次生成、跨店复用；按 (country, subcategory) 一行，
// items 内嵌多语菜品数组。上架/引导时读此表写入 ShopDraft → Product
model FoodPreset {
  id            String   @id @default(cuid())
  vertical      Vertical @default(FOOD) // 本批只做 food 垂直
  cuisine       String   @default("vn") // 菜系维度（第 20 批中越拆分）：vn 越南菜 / cn 中国菜 / drink 酒水饮品
  subcategory   String // 子分类 slug：pho / bun / hotpot-cn-meat / beer ...
  locale        String   @default("vi") // 生成主语言（nativeName 的语言）
  country       String   @default("VN") // 多国预留：只有 VN 填数据
  items         Json // [{ nativeName, name_en, name_zh, description_local, description_en, defaultPrice, currency, extras[], allergens[], dietaryTags[], optionGroups[], imagePrompt, imageUrl }]
  promptVersion String? // 生成 prompt 版本（升级后可用于重生成）
  modelUsed     String? // ds / minimax / gemini（本次实际用的）
  priceSource   String? // 定价来源/规则说明
  active        Boolean  @default(true) // 启用/停用（admin 可切）
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([country, cuisine, subcategory])
  @@index([country, cuisine, subcategory, active])
}

// 自定义预设品类（第 20 批 Admin「新增品类」）：Admin 手动注册的元数据，脚本按此生成 FoodPreset
// 与 FOOD_SUBCATEGORIES 静态 35 类并存：静态类从代码读 meta，自定义类从此表读
// （FoodPreset 均按 (country,cuisine,subcategory) upsert，两类生成结果无差别）
model PresetCategory {
  id        String   @id @default(cuid())
  key       String   @unique // 子分类 slug（对应 FoodPreset.subcategory）
  nameVi    String // 越南语分类名
  nameZh    String // 中文分类名
  nameEn    String // 英文分类名
  cuisine   String   @default("vn") // vn 越南菜 / cn 中国菜 / drink 酒水饮品
  count     Int      @default(40) // 目标道数
  examples  String[] // 维度指引（多方位，参考不限定）
  active    Boolean  @default(true) // 停用后不再用于生成/展示
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 开店引导草稿（第 19 批 9.1）：独立表替代 Shop.config.draftMenu（jsonb 混存），
// 草稿与营业设置互不污染，可独立查询/恢复
model ShopDraft {
  id        String   @id @default(cuid())
  shopId    String   @unique
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  presetId  String? // 来源 FoodPreset.id（可空=手工/AI 加菜草稿）
  items     Json // 引导草稿菜品（结构与 Product.config 兼容，上架前老板可编辑）
  snapshot  Json? // 覆盖上架前的现有 Product[] 快照（9.2 一键还原用）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- 平台级设置中心（2026-08-29 扩展）----

// 平台级键值配置表（设置中心地基）：key ∈ ai/oauth/site/security/maintenance/billing/notification/webhooks/onboarding
// value 为各块 jsonb；敏感字段（AI key / OAuth secret / SMTP 密码 / 网关密钥）AES 加密后存入（lib/secret-crypto.ts）
model PlatformSetting {
  key       String   @id
  value     Json?
  updatedAt DateTime @updatedAt
}

// 平台审计日志：谁/何时/改了什么（管理后台基本盘；写入失败不阻塞主操作）
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // User.id；null=系统/脚本
  actorName  String?
  action     String // login / shop_manage / bill / config_change / totp / plan / announcement / apikey / auth
  targetType String? // shop / user / plan / setting / announcement / apikey
  targetId   String?
  detail     Json? // 变更前后快照等
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// 套餐定义（收费扩展骨架）：plan 字符串 → 档位表；限额字段本期只存不校验
model PlanTier {
  key          String   @id // TRIAL / BASIC / PRO
  name         String
  nameI18n     Json? // 多语展示名（预留）
  price        Decimal  @default(0) @db.Decimal(12, 2)
  months       Int      @default(1) // 每期时长（月）
  shopLimit    Int? // 店铺数上限（null=不限）
  productLimit Int? // 商品数上限
  aiQuota      Int? // AI 生成配额（次/月）
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 平台公告（多条，前台 banner 展示后置；区别于维护模式单条文案）
model PlatformAnnouncement {
  id        String   @id @default(cuid())
  title     String
  body      String
  locale    String? // null=全语言
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 平台 API key（开发者预留：生成/撤销/列表，调用校验后置；明文仅创建时显示一次）
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique // 只存哈希（sha256），不存明文
  scope      String    @default("platform")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// 网站访问统计（2026-08-29 访问记录功能）：客户端页面访问埋点记录
// 来源国家读 Cloudflare CF-IPCountry 头（隧道免费带），IP 读 CF-Connecting-IP，免 GeoIP 库
model VisitLog {
  id        String   @id @default(cuid())
  path      String // 访问路径（含 locale 前缀，如 /vi/s/demo-pho）
  referer   String? // document.referrer（来源页）
  ip        String? // 访客 IP（CF-Connecting-IP）
  country   String? // 来源国家（CF-IPCountry，2 位代码）
  ua        String? // User-Agent
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

// ---- MOTO 垂直（plans/12-moto-implementation.md M1，2026-08-31 执行）----

// 摩托车辆档案（M1）：车牌唯一 + 履历 + 下次保养 + 同手机号其他车
// 约定：plate 一律存 normalize 后格式（去空格/连字符/大写，见 lib/plate.ts），查询先 normalize 再精确匹配
// 保养字段更新时机 = picked_up（交接）时，见计划 8.2（createMotoOrder 只开单不写保养，取消单不算）
model Vehicle {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plate            String // 车牌（normalize 后，如 29A112345）
  brand            String? // 品牌（如 Honda）
  model            String? // 型号（如 Wave Alpha）
  year             Int? // 年份
  mileage          Int? // 里程（可空：新车建档无里程）
  ownerName        String? // 车主姓名
  ownerPhone       String? // 车主手机号（入库前 lib/phone.ts 归一化，同 User 表）
  notes            String? // 备注（车况/特殊事项）
  lastServiceAt    DateTime? // 最近一次保养时间（picked_up 交接时更新）
  nextServiceKm    Int? // 下次保养里程（OIL 双维度；交接时更新）
  nextServiceDue   DateTime? // 下次保养到期日（OIL/PERIODIC；交接时更新）
  lastIntervalDays Int? // 上次保养间隔天数（算法参考，老板可调）
  ownerCustomerId  String? // 认领客户（一客户多车）
  ownerCustomer    Customer? @relation(fields: [ownerCustomerId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shopId, plate])
  @@index([shopId, ownerPhone])
}

// 客户账号（M6a 用，M1 建表）：手机号+密码登录（复用 Auth.js 加 customer provider）
// 认领绑定：Customer → Vehicle.ownerCustomerId（一客户多车）；phone 入库前 lib/phone.ts 归一化
// 身份融合（2026-08-31 用户拍板，多垂直地基）：预留 username @unique + OAuth 字段（provider/providerId/email/image）。
// phone/passwordHash 改可空——纯 OAuth(google/fb) 客户无手机号/无密码；loginKey 登录键统一 OR[username,phone]（同 User 先例）。
model Customer {
  id           String    @id @default(cuid())
  username     String?   @unique // 自定义用户名（无手机号客户主登录键）；纯手机号客户 null。本期只预留，登录 UI 后置
  phone        String?   @unique // 归一化手机号；username 与 phone 至少其一来登录（先验后取其一）
  passwordHash String?          // bcrypt；纯 OAuth(google/fb) 客户可为 null
  name         String?
  email        String?          // OAuth 客户邮箱（FB 纯移动端可能不返回，允许 null）；不设 @unique——同一邮箱可跨 provider 各建一个 Customer，幂等锚是 @@unique([provider,providerId])
  image        String?          // OAuth 头像（本期首字母色块兜底，不渲染外部头像）
  provider     String    @default("password") // 登录来源留痕："password"|"google"|"facebook"
  providerId   String?          // google sub / fb id；password/uname 客户为 null
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicles Vehicle[]
  orders   Order[]

  @@unique([provider, providerId]) // 仅 OAuth 幂等锚（password 客户 providerId=null，Postgres 唯一索引视 NULL 互异不生效）
  @@index([phone])
}

// moto 服务预设库（中台维护/下发，仿 FoodPreset 但独立表）：一服务一行
// 不复用 FoodPreset（其结构=子分类含 items 数组，moto=一服务一行，不匹配）
model MotoPreset {
  id              String   @id @default(cuid())
  serviceKey      String   @unique // 唯一 key，如 oil_change
  nameVi          String // 越南语服务名（如 Thay nhớt máy）
  nameZh          String // 中文服务名（如 换机油）
  nameEn          String // 英文服务名
  defaultPrice    Decimal  @db.Decimal(12, 2) // 默认价（进件时可改）
  unit            String? // 单位（次/升/个）
  category        String // 分类：保养|维修|检查（bảo dưỡng|sửa chữa|kiểm tra）
  maintenanceType String // 保养类型：OIL|PERIODIC|REPAIR（REPAIR 不写保养）
  intervalKm      Int? // 保养间隔里程（OIL 2000 / PERIODIC 默认 4000）
  intervalDays    Int? // 保养间隔天数（OIL 180 / PERIODIC 120）
  active          Boolean  @default(true) // 启用/停用（admin 可切）
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, active])
  @@index([maintenanceType, active])
}
